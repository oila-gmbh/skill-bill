<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.skillbill.status</id>
    <name>Skill Bill</name>
    <vendor url="https://skill-bill.dev">Skill Bill</vendor>

    <!--
      Supported products: IntelliJ IDEA Community and Ultimate only.
      Compatibility: IDEA 2025.2 (build 252) and newer. No until-build, so newer
      IDEs load the plugin; since-build is patched from gradle.properties.
    -->
    <idea-version since-build="252"/>

    <description><![CDATA[
      Shows Skill Bill feature-work status in IntelliJ IDEA. Consumes the
      versioned <code>skill-bill work status</code> contract, and from the status
      details popup invokes exactly two mutating verbs,
      <code>skill-bill goal stop</code> and <code>skill-bill goal pause</code>,
      for the active goal. It reads no Skill Bill databases and terminates no
      processes itself.
    ]]></description>

    <!-- Platform module only — no Java, Kotlin, Android, or other language-plugin deps. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
            serviceImplementation="dev.skillbill.intellij.composition.SkillBillProjectStatusService"/>
        <projectService
            serviceImplementation="dev.skillbill.intellij.infrastructure.prefs.SkillBillProjectDisplayCache"/>
        <applicationService
            serviceImplementation="dev.skillbill.intellij.infrastructure.prefs.SkillBillApplicationSettings"/>
        <statusBarWidgetFactory
            id="SkillBillStatusBarWidget"
            implementation="dev.skillbill.intellij.ui.SkillBillStatusBarWidgetFactory"
            order="after Position"/>
    </extensions>
</idea-plugin>
