#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$repo_root"
skill-bill validate --repo-root "$repo_root"

cd "$repo_root/runtime-kotlin"
./gradlew check

cd "$repo_root"
npx --yes agnix@0.44.0 --strict .
scripts/validate_agent_configs "$repo_root"
